      // battery voltage
      battery_current_ = data->power_a;
      battery_voltage_ = data->power_v;

      RCLCPP_INFO(this->get_logger(),
                  "Battery state -- current: %f; voltage: %f", battery_current_,
                  battery_voltage_);
