    Request req;
    req.header.identity.api_id = ROBOT_API_ID_LOCO_GET_AVAILABLE_FSM_IDS;
    nlohmann::json js;
    int32_t ret = base_client_.Call(req, js);
    if (ret == 0) {
      ids.clear();
      names.clear();
      if (js.contains("ids")) js["ids"].get_to(ids);
      if (js.contains("names")) js["names"].get_to(names);
